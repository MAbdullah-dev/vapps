# Cloudflare Turnstile (optional in dev if unset). Set both for login + register protection.
# Dashboard: Cloudflare → Turnstile → Add widget (same keys for dev hostnames if needed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Authenticator app 2FA secret encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
# Google Translate (REST API v2) — server-side only. Enables UI language switching.
# Create a key in Google Cloud Console → APIs & Services → Credentials → Create credentials → API key.
# Restrict the key to “Cloud Translation API” for production.
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# Optional: fetch timeout for translate calls (milliseconds)
# GOOGLE_TRANSLATE_FETCH_TIMEOUT_MS=30000

